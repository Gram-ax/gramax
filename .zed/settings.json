{
	"languages": {
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSON": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSONC": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"YAML": {
			"formatter": "language_server",
			"hard_tabs": false
		},
		"CSS": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TOML": {
			"formatter": { "external": { "command": "taplo", "arguments": ["fmt", "-"] } }
		},
		"Dockerfile": {
			"formatter": "language_server"
		}
	},
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"tsserver": {
						"maxTsServerMemory": 16384
					},
					"preferences": {
						"importModuleSpecifier": "non-relative"
					}
				}
			}
		},
		"yaml-language-server": {
			"binary": {
				"path": "~/Source/repos/yaml-language-server/bin/yaml-language-server",
				"arguments": ["--stdio"]
			},
			"settings": {
				"yaml": {
					"customTags": ["!reference sequence"],
					"format": {
						"hardTabs": false,
						"singleQuote": true
					},
					"schemas": {
						"https://gitlab.com/gitlab-org/gitlab/-/raw/master/app/assets/javascripts/editor/schema/ci.json": [
							".ci/**/*.yml",
							".gitlab-ci.yml"
						]
					}
				}
			}
		},
		"rust-analyzer": {
			"initialization_options": {
				"imports": {
					"granularity": {
						"enforce": true,
						"group": "item"
					},
					"group": {
						"enable": true
					}
				},
				"cargo": {
					// "target": "wasm32-unknown-emscripten",
					// "target": "x86_64-pc-windows-msvc",
					"features": [],
					"extraEnv": {
						"BUGSNAG_API_KEY": ""
						// "CFLAGS": "-Wno-error=incompatible-pointer-types"
					}
				},
				"check": { "command": "clippy" }
				// "check": { "targets": "wasm32-unknown-emscripten", "command": "clippy", "allTargets": true }
				// "check": { "targets": "x86_64-pc-windows-msvc", "command": "clippy", "allTargets": true },
				// "extraEnv": {
				// 	"BUGSNAG_API_KEY": "",
				// 	"TARGET_CC": "clang",
				// 	"CFLAGS": "-I${env:HOME}/.xwin/splat/crt/include/ -I${env:HOME}/.xwin/splat/sdk/include/um -I${env:HOME}/.xwin/splat/sdk/include/ucrt -I${env:HOME}/.xwin/splat/sdk/include/shared -I${env:HOME}/.xwin/splat/sdk/include/winrt",
				// 	"CARGO": "${env:HOME}/.cargo/bin/cargo-xwin"
				// }
			}
		}
	}
}
